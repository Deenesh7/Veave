{
  "name": "veave-backend",
  "version": "1.0.0",
  "description": "Express.js backend for Veave AI",
  "main": "src/server.js",
  "scripts": {
    "prestart": "node scripts/sync-transformer.cjs",
    "predev": "node scripts/sync-transformer.cjs",
    "start": "node --no-warnings src/server.js",
    "dev": "nodemon --no-warnings --watch src --watch ../frontend/src/utils/codeTransformer.js src/server.js",
    "test": "node --no-warnings --test",
    "runner:build": "docker build -t veave-validator:1 runner",
    "test:browser": "node --test test/browserValidation.test.js",
    "test:runner": "node scripts/verify-runner.cjs",
    "test:clone-smoke": "node scripts/smoke-clone.cjs",
    "test:public-assets": "node scripts/smoke-public-assets.cjs",
    "dump:db": "node scripts/dump-db.cjs",
    "restore:db": "node scripts/restore-db.cjs",
    "claim:projects": "node scripts/claim-projects.cjs",
    "migrate:collab": "node scripts/migrate-collaboration.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/lib-storage": "^3.1148.0",
    "@babel/parser": "^7.29.9",
    "@babel/standalone": "^7.28.4",
    "@xenova/transformers": "^2.17.2",
    "apple-signin-auth": "^2.1.0",
    "archiver": "^7.0.1",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.3.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.1",
    "postcss": "^8.5.28",
    "razorpay": "^2.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "tldts": "^6.1.86",
    "typescript": "^5.9.3",
    "typescript-language-server": "^6.0.2",
    "uuid": "^10.0.0",
    "vscode-langservers-extracted": "^4.10.0",
    "wavefile": "^11.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.3",
    "playwright": "1.58.2"
  },
  "overrides": {
    "@xenova/transformers": {
      "sharp": "$sharp"
    }
  }
}
