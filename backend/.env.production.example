# Copy to backend/.env on the production server and fill in the secrets (JWT, Mongo, S3, OAuth, Razorpay, LLM keys).
# Only the domain-related settings are listed here.

NODE_ENV=production
PORT=5001

# The app and the API are served from app.veave.net; published sites from <slug>.veave.net.
CLIENT_URL=https://app.veave.net
PUBLISH_BASE_DOMAIN=veave.net
PUBLISH_SCHEME=https
PUBLISH_PUBLIC_PORT=

# Persistent disk for published sites (back it up; it is the only copy of published builds).
PUBLISH_STORAGE_DIR=/var/lib/veave/published

# Production builds must run in the Docker validator: run `npm run runner:build` in backend first.
PUBLISH_ALLOW_LOCAL_BUILD=false
# After each publish, also request the public https://<slug>.veave.net URL (reports DNS/TLS problems).
PUBLISH_VERIFY_PUBLIC_URL=true

# Custom domains. PUBLISH_SERVER_IP is the public IPv4 of the ingress (Caddy) that customers' domains must point at: the
# A record for a root domain, and what Veave checks public DNS against. REQUIRED for connecting root domains.
PUBLISH_SERVER_IP=
# Only if the ingress also has a public IPv6 address (otherwise a customer's stale AAAA record is flagged).
PUBLISH_SERVER_IPV6=

# Secret that binds ownership-verification TXT values to a hostname, user and project (HMAC). REQUIRED in production,
# at least 16 characters, generate with `openssl rand -hex 32`. Changing it invalidates unfinished verifications.
DOMAIN_VERIFY_SECRET=
# Public resolvers used for ownership and propagation checks (never the server's own cache).
DNS_RESOLVERS=1.1.1.1,8.8.8.8,9.9.9.9
# Optional tuning (defaults shown): verification validity, DNS propagation allowance, re-check of live domains,
# scheduler interval, certificate attempts before failing, renew-warning window.
# DOMAIN_VERIFY_TTL_HOURS=168
# DOMAIN_DNS_WAIT_HOURS=72
# DOMAIN_HEALTH_INTERVAL_HOURS=6
# DOMAIN_ORCHESTRATOR_INTERVAL_MS=10000
# DOMAIN_SSL_MAX_ATTEMPTS=8
# DOMAIN_SSL_RENEW_WITHIN_DAYS=14
# Optional GoDaddy integration (https://github.com/godaddy/cli): install `gddy` on the server and create a Personal
# Access Token with `gddy pat create`. Lets Veave set DNS records automatically for domains in YOUR GoDaddy account.
GDDY_PAT=
# Domain sales: customers pay in INR through Razorpay; price = GoDaddy USD price x rate x (1 + markup%).
USD_INR_RATE=90
DOMAIN_MARKUP_PERCENT=15
# Razorpay dashboard > Webhooks: URL https://app.veave.net/api/hosting/razorpay-webhook, event payment.captured.
# Registers the domain even if the customer closes the browser right after paying.
RAZORPAY_WEBHOOK_SECRET=

# Sign-in callbacks (register these exact URLs in Google Cloud Console / Apple developer settings).
GOOGLE_CALLBACK_URL=https://app.veave.net/api/auth/google/callback
APPLE_CALLBACK_URL=https://app.veave.net/api/auth/apple/callback

# Extra browser origins allowed to make changing requests to the API (comma separated). Normally empty.
ALLOWED_ORIGINS=

# Outgoing email (group invitations). Any SMTP provider works (Gmail app password, SendGrid, Resend, Mailgun, SES SMTP).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Veave <no-reply@veave.net>"

# Email the user when a plan is ready for approval and when a project finishes building. Set to false to disable.
JOB_EMAILS=true

# Model used by the incremental editor (edits to an existing project). Falls back to CLONE_OPENROUTER_MODEL when empty.
INCREMENTAL_OPENROUTER_MODEL=openai/gpt-6-luna
