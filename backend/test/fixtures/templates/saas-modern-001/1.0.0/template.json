    },
    {
      "name": "Section",
      "path": "src/components/Section.jsx",
      "role": "Section wrapper, container and section heading primitives",
      "shared": true
    },
    {
      "name": "FeatureCard",
      "path": "src/components/FeatureCard.jsx",
      "role": "Card with optional image, icon, title and text",
      "shared": false
